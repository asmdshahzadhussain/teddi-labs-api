# TEDDI Labs - Environment Variables
# Copy this to .env and fill in your actual values

# Supabase PostgreSQL Connection String
TEDDI_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-0-xxx.supabase.co:5432/postgres

# TEDDI Admin Key (must match the one in your database)
TEDDI_ADMIN_API_KEY=TEDDI_ADMIN_REFILL_2026